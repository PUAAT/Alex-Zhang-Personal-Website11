# Public site works with NONE of these set. They are only needed for the admin CMS and contact form.

NEXT_PUBLIC_SITE_URL=https://example.com

# Supabase (CMS). The anon key is safe in the browser ONLY because Row Level Security is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_. Never import in a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Email of the single administrator allowed into /admin (checked server-side).
ADMIN_EMAIL=
